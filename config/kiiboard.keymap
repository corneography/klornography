#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt { tapping-term-ms = <150>; };

&lt { flavor = "hold-preferred"; };

/ {
    combos {
        compatible = "zmk,combos";

        bluetooth {
            bindings = <&mo 9>;
            key-positions = <8 12>;
            layers = <0>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <17 18>;
            layers = <0 2>;
            timeout-ms = <20>;
            require-prior-idle-ms = <20>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <18 19>;
            layers = <0 2>;
            timeout-ms = <20>;
            require-prior-idle-ms = <20>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <17 19>;
            layers = <0 2>;
            require-prior-idle-ms = <20>;
            timeout-ms = <20>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <45 44>;
            layers = <0 2>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
        };

        redo {
            bindings = <&kp LC(Y)>;
            key-positions = <46 47>;
            layers = <0 2>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
        };

        redo_alt {
            bindings = <&kp LC(LS(Z))>;
            key-positions = <46 47 45>;
            layers = <0>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
        };

        to_bootloader {
            bindings = <&bootloader>;
            key-positions = <56 13 63 0>;
        };

        toggle_reference_track {
            bindings = <&kp KP_DOT>;
            key-positions = <70 69>;
            layers = <2>;
        };

        save {
            bindings = <&kp LC(S)>;
            key-positions = <47 46 45 44>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0 2>;
        };

        renoise_layer {
            bindings = <&tog 2>;
            key-positions = <55 63>;
        };

        gaming_layer {
            bindings = <&tog 5>;
            key-positions = <55 63 41>;
        };

        caps_lock {
            bindings = <&kp CAPS>;
            key-positions = <58 66>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };
    };

    macros {
        kp_plus_tog: kp_plus_to {
            /**
            * Executes a keypress of choosing. Then toggles a chosen layer.
            *
            *
            * Params:
            *  1. Desired keypress
            *  2. Layer to toggle
            *
            * Example:
            *  `&kp_plus_to KEYPRESS NUM_LAYER`
            */

            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER &macro_param_2to1>,
                <&macro_tap>,
                <&tog MACRO_PLACEHOLDER>;
        };

        mo_plus_ctrl: mo_plus_ctrl {
            /**
            * Switches to a layer (`&mo`) while a holding CTRL.
            * Goes to another layer after release. Generally used to return to the initial layer, hence "mo".
            *
            * Params:
            *  1. Layer to switch to
            *  2. Layer to return to
            *
            * Example:
            *  `&mo_plus_ctrl NUM_LAYER NUM_LAYER`
            */

            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1>,
                <&macro_tap>,
                <&to MACRO_PLACEHOLDER>,
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LCTRL &macro_param_2to1>,
                <&macro_tap>,
                <&to MACRO_PLACEHOLDER>;
        };

        lm: lm {
            /**
             * Temporarily switches to a layer (`&mo`) while a modifier is held.
             * Analogous to QMK's `LM()`, using a parameterized macro.
             *
             * Params:
             *  1. Layer to switch to
             *  2. Modifier to press while layer is active
             *
             * Example:
             *  `&lm NUM_LAYER LSHIFT`
             */

            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press>,
                <&mo MACRO_PLACEHOLDER &macro_param_2to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER &macro_param_1to1>,
                <&macro_release>,
                <&mo MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        alt_f4: alt_f4 {
            compatible = "zmk,behavior-tap-dance";
            label = "ALT_F4";
            #binding-cells = <0>;
            bindings = <&kp F4>, <&kp LA(F4)>;
        };

        paste_fill: paste_fill {
            compatible = "zmk,behavior-tap-dance";
            label = "PASTE_FILL";
            #binding-cells = <0>;
            bindings = <&kp LC(V)>, <&kp LC(P)>;
        };

        parenthesis: parenthesis {
            compatible = "zmk,behavior-tap-dance";
            label = "PARENTHESIS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        square_brakets: square_brakets {
            compatible = "zmk,behavior-tap-dance";
            label = "SQUARE_BRAKETS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        f9: f9 {
            compatible = "zmk,behavior-tap-dance";
            label = "F9";
            #binding-cells = <0>;
            bindings = <&kp F9>, <&kp C_NEXT>;
        };

        f10: f10 {
            compatible = "zmk,behavior-tap-dance";
            label = "F10";
            #binding-cells = <0>;
            bindings = <&kp F10>, <&kp C_PREV>;
        };

        typing_or_default: typing_or_default {
            compatible = "zmk,behavior-tap-dance";
            label = "TYPING_OR_DEFAULT";
            #binding-cells = <0>;
            bindings = <&to 0>, <&to 0>;
        };

        default_or_gaming: default_or_gaming {
            compatible = "zmk,behavior-tap-dance";
            label = "DEFAULT_OR_GAMING";
            #binding-cells = <0>;
            bindings = <&to 0>, <&to 5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------------------------------------
            // |  HOME   |    `    |    1    |    2    |    3    |    4    |    5    |                 |    6    |    7    |    8    |    9    |    0    |    [    |    ]    |
            // |   END   |    *    |    Q    |    Y    |    O    |    U    |    =    |                 |    X    |    L    |    D    |    P    |    Z    |   BACK  |    ]    |
            // |  PGUP   |    B    |    C    |    I    |    A    |    E    |    -    |                 |    K    |    H    |    T    |　  N    |    S    |    W    |    /    |
            // |  PGDWN  |    .    |    '    |    ,    |    .    |    ;    |    /    |                 |    J    |    M    |    G    |    F    |    V    |   INS   |   DEL   |
            // |    ?    |    ?    |   ESC   |   ALT   |                                                                             |    UP   |  RIGHT  |  PSCRN  |   SLCK  |
            // |   ENC   |         |   CTL   |   SFT   |   SPC   |    ?    |                                     |    R    |   ENT   |   LFT   |   DWN   |         |   ENC   |

            bindings = <
&kp HOME   &kp GRAVE        &kp N1     &kp N2           &kp N3     &kp N4      &kp N5               &kp N6  &kp N7  &kp N8   &kp N9    &kp N0     &kp LBKT   &kp RBKT
&kp END    &kp KP_MULTIPLY  &kp Q      &kp Y            &kp O      &kp U       &kp EQUAL            &kp X   &kp L   &kp D    &kp P     &kp Z      &kp BSPC   &kp F14
&kp PG_UP  &kp B            &kp C      &kp I            &kp A      &kp E       &kp MINUS            &kp K   &kp H   &kp T    &kp N     &kp S      &kp W      &kp BACKSLASH
&kp PG_DN  &kp TAB          &kp SQT    &kp COMMA        &kp DOT    &kp SEMI    &mt BACKSLASH SLASH  &kp J   &kp M   &kp G    &kp F     &kp V      &kp INS    &kp DEL
&kp F13    &kp LGUI         &kp ESC    &kp LALT                                                                              &kp UP    &kp RIGHT  &kp PSCRN  &kp SLCK
&kp C_PP                    &kp LCTRL  &mt LSHIFT BSPC  &kp SPACE  &lt 1 EXCL                               &kp R   &kp RET  &kp LEFT  &kp DOWN              &kp C_MUTE
            >;

            sensor-bindings = <&inc_dec_kp RIGHT LEFT &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
            bindings = <
&trans  &trans              &trans   &trans     &trans     &trans  &trans         &trans           &trans      &trans  &trans     &trans                     &trans    &trans
&trans  &kp DOLLAR          &kp F12  &kp F11    &f10       &f9     &kp POUND      &square_brakets  &kp N7      &kp N8  &kp N9     &trans                     &trans    &trans
&trans  &kp PERCENT         &kp F8   &kp F7     &kp F6     &kp F5  &kp AT         &parenthesis     &kp N4      &kp N5  &kp N6     &mt KP_PLUS KP_MINUS       &kp AMPS  &trans
&trans  &default_or_gaming  &alt_f4  &kp F3     &kp F2     &kp F1  &kp BACKSLASH  &kp N0           &kp N1      &kp N2  &kp N3     &mt KP_MULTIPLY KP_DIVIDE  &trans    &trans
&trans  &kp C_PWR           &trans   &trans                                                                            &kp PG_UP  &kp END                    &trans    &trans
&trans                      &trans   &kp LG(L)  &kp LG(R)  &trans                                  &kp PERIOD  &trans  &kp HOME   &kp PG_DN                            &trans
            >;
        };

        renoise {
            bindings = <
&trans  &none      &kp F1       &kp F2          &kp F3     &kp F4           &none     &none          &kp F9             &kp F10    &kp F11   &kp F12    &none                 &none
&trans  &tog 8     &kp E        &kp R           &kp N5     &kp T            &kp BSPC  &kp BACKSPACE  &kp N6             &kp Y      &kp N7    &kp U      &kp_plus_tog MINUS 8  &none
&trans  &kp A      &kp H        &kp N           &kp J      &kp M            &kp INS   &kp INSERT     &kp Q              &kp N2     &kp W     &kp N3     &kp_plus_tog SQT 8    &none
&trans  &kp GRAVE  &kp Z        &kp S           &kp X      &kp D            &kp DEL   &kp DEL        &kp C              &kp V      &kp G     &kp B      &none                 &none
&none   &none      &kp ESC      &lm 8 LALT                                                                                         &kp UP    &kp RIGHT  &none                 &none
&trans             &lm 8 LCTRL  &kp LEFT_SHIFT  &kp SPACE  &lt 3 KP_DIVIDE                           &lt 4 KP_ASTERISK  &kp ENTER  &kp LEFT  &kp DOWN                         &kp BSLH
            >;

            sensor-bindings =
                <&inc_dec_kp RIGHT LEFT>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        renoise_l_layer {
            bindings = <
&trans  &trans     &trans   &trans   &trans     &trans  &trans  &trans           &trans      &trans  &trans     &trans                     &trans    &trans
&trans  &kp GRAVE  &kp F12  &kp F11  &f10       &f9     &trans  &square_brakets  &kp N7      &kp N8  &kp N9     &kp SCROLLLOCK             &trans    &trans
&trans  &trans     &kp F8   &kp F7   &kp F6     &kp F5  &trans  &parenthesis     &kp N4      &kp N5  &kp N6     &mt KP_PLUS KP_MINUS       &kp AMPS  &trans
&trans  &trans     &alt_f4  &kp F3   &kp F2     &kp F1  &trans  &kp N0           &kp N1      &kp N2  &kp N3     &mt KP_MULTIPLY KP_DIVIDE  &trans    &trans
&trans  &trans     &trans   &trans                                                                   &kp PG_UP  &kp END                    &trans    &trans
&trans             &trans   &trans   &kp KP_N0  &trans                           &kp PERIOD  &trans  &kp HOME   &kp PG_DN                            &trans
            >;
        };

        renoise_r_layer {
            bindings = <
&trans     &none   &none             &none           &none      &none      &none      &none      &none              &none              &none        &none      &none  &none
&trans     &none   &none             &none           &none      &none      &none      &kp LC(Y)  &kp LC(LS(MINUS))  &kp LC(LS(EQUAL))  &paste_fill  &none      &none  &none
&trans     &none   &kp LA(H)         &kp LS(ESCAPE)  &kp LA(K)  &kp LA(J)  &kp LA(I)  &kp LC(Z)  &kp LC(MINUS)      &kp LC(EQUAL)      &kp LC(C)    &none      &none  &none
&trans     &none   &none             &none           &none      &none      &none      &kp LA(M)  &kp LA(T)          &kp LC(A)          &kp LC(X)    &none      &none  &none
&trans     &trans  &kp ESC           &kp LEFT_ALT                                                                                      &kp UP       &kp RIGHT  &none  &none
&kp ENTER          &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp SPACE  &mo 0                            &trans             &kp ENTER          &kp LEFT     &kp DOWN          &kp BSLH
            >;

            sensor-bindings =
                <&inc_dec_kp RIGHT LEFT>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        gaming_layer {
            bindings = <
&kp HOME   &kp GRAVE        &kp N1     &kp N2           &kp N3     &kp N4    &kp N5     &kp N6  &kp N7   &kp N8   &kp N9    &kp N0     &kp LBKT   &kp RBKT
&kp END    &kp KP_MULTIPLY  &kp Q      &kp Y            &kp W      &kp U     &kp EQUAL  &kp X   &kp L    &kp E    &kp P     &kp Z      &kp BSPC   &kp F14
&kp PG_UP  &kp B            &kp C      &kp A            &kp S      &kp D     &kp MINUS  &kp K   &kp H    &kp T    &kp N     &kp I      &kp O      &kp BACKSLASH
&kp PG_DN  &kp TAB          &kp SQT    &kp COMMA        &kp DOT    &kp SEMI  &kp SLASH  &kp J   &kp M    &kp G    &kp F     &kp V      &kp INS    &kp DEL
&none      &none            &kp ESC    &kp LALT                                                                   &kp UP    &kp RIGHT  &kp PSCRN  &kp SLCK
&kp C_PP                    &kp LCTRL  &mt LSHIFT BSPC  &kp SPACE  &mo 6                        &lt 7 R  &kp RET  &kp LEFT  &kp DOWN              &kp C_MUTE
            >;

            sensor-bindings =
                <&inc_dec_kp RIGHT LEFT>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        gaming_fn_l {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp N4 N2>, <&inc_dec_kp N4 NUMBER_2>;
        };

        gaming_fn_r {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp E Q>, <&inc_dec_kp N4 NUMBER_2>;
        };

        quick_type {
            bindings = <
&kp HOME   &kp GRAVE  &kp N1              &kp N2           &kp N3     &kp N4    &kp N5     &kp N6  &kp N7  &kp N8                &kp N9    &kp N0     &kp LBKT   &kp RBKT
&kp END    &tog 8     &kp Q               &kp Y            &kp O      &kp U     &kp EQUAL  &kp X   &kp L   &kp D                 &kp P     &kp Z      &kp BSPC   &kp RBKT
&kp PG_UP  &kp B      &kp C               &kp I            &kp A      &kp E     &kp MINUS  &kp K   &kp H   &kp T                 &kp N     &kp S      &kp W      &kp BACKSLASH
&kp PG_DN  &kp TAB    &kp SQT             &kp COMMA        &kp DOT    &kp SEMI  &kp SLASH  &kp J   &kp M   &kp G                 &kp F     &kp V      &kp INS    &kp DEL
&kp TAB    &kp LGUI   &kp_plus_tog ESC 8  &kp LALT                                                                               &kp UP    &kp RIGHT  &kp PSCRN  &kp SLCK
&kp C_PP              &kp LCTRL           &mt LSHIFT BSPC  &kp SPACE  &mo 1                        &kp R   &kp_plus_tog ENTER 8  &kp LEFT  &kp DOWN              &kp C_MUTE
            >;

            sensor-bindings =
                <&inc_dec_kp RIGHT LEFT>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        qwerty {
            // ---------------------------------------------------------------------------------------------------------------------------------------------------------------
            // |  HOME   |    `    |    1    |    2    |    3    |    4    |    5    |                 |    6    |    7    |    8    |    9    |    0    |    -    |    =    |
            // |   END   |    *    |    Q    |    W    |    E    |    R    |    T    |                 |    Y    |    U    |    I    |    O    |    P    |    [    |    ]    |
            // |  PGUP   |    -    |    A    |    S    |    D    |    F    |    G    |                 |    H    |    J    |    K    |　  L    |    ;    |    '    |    /    |
            // |  PGDWN  |    .    |    Z    |    X    |    C    |    V    |    B    |                 |    N    |    M    |    ,    |    .    |    /    |   INS   |   DEL   |
            // |    ?    |    ?    |   ESC   |   ALT   |                                                                             |    UP   |  RIGHT  |  PSCRN  |   SLCK  |
            // |   ENC   |         |   CTL   |   SFT   |   SPC   |    ?    |                                     |    ?    |   ENT   |   LFT   |   DWN   |         |   ENC   |

            bindings = <
&kp HOME   &kp GRAVE        &kp N1     &kp N2                    &kp N3     &kp N4  &kp N5  &kp N6  &kp N7   &kp N8     &kp N9    &kp N0     &kp MINUS  &kp EQUAL
&kp END    &kp KP_MULTIPLY  &kp Q      &kp W                     &kp E      &kp R   &kp T   &kp Y   &kp U    &kp I      &kp O     &kp P      &kp LBKT   &kp RBKT
&kp PG_UP  &kp CAPS         &kp A      &kp S                     &kp D      &kp F   &kp G   &kp H   &kp J    &kp K      &kp L     &kp SEMI   &kp SQT    &kp BACKSLASH
&kp PG_DN  &kp KP_DOT       &kp Z      &kp X                     &kp C      &kp V   &kp B   &kp N   &kp M    &kp COMMA  &kp DOT   &kp SLASH  &kp INS    &kp DEL
&kp F13    &kp LEFT_GUI     &kp ESC    &kp LALT                                                                         &kp UP    &kp RIGHT  &kp PSCRN  &kp SLCK
&kp C_PP                    &kp LCTRL  &mt LEFT_SHIFT BACKSPACE  &kp SPACE  &mo 1                   &kp F16  &kp RET    &kp LEFT  &kp DOWN              &kp C_MUTE
            >;
        };

        bluetooth {
            bindings = <
&trans      &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans        &trans        &trans        &trans  &trans  &trans
&bt BT_CLR  &trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans        &trans        &trans        &trans  &trans  &trans
&trans      &trans  &trans        &trans        &trans        &trans        &trans        &trans  &bt BT_SEL 3  &bt BT_SEL 4  &trans        &trans  &trans  &trans
&trans      &trans  &trans        &trans        &trans        &trans        &trans        &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans  &trans
&trans      &trans  &trans        &trans                                                                                      &trans        &trans  &trans  &trans
&trans              &trans        &trans        &trans        &trans                              &trans        &trans        &trans        &trans          &trans
            >;
        };
    };
};
